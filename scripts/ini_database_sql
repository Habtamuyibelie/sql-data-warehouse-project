ALTER SESSION SET CONTAINER = CDB$ROOT;
ALTER SESSION SET CONTAINER = CDB$ROOT;
SELECT SYS_CONTEXT('USERENV', 'CON_NAME') FROM DUAL;
SELECT name, open_mode FROM v$pdbs;
alter session set container = datawarehouse;
ALTER PLUGGABLE DATABASE datawarehouse OPEN;
ALTER PLUGGABLE DATABASE datawarehouse SAVE STATE;

CREATE PLUGGABLE DATABASE datawarehouse
  ADMIN USER HABTAMU IDENTIFIED BY "root"
  FILE_NAME_CONVERT = ('D:\APP\ADMINISTRATOR\VIRTUAL\ORADATA\ORCL\PDBSEED\',
                       'D:\APP\ADMINISTRATOR\VIRTUAL\ORADATA\ORCL\FCUBSPDB\');

CREATE TABLESPACE DWH_DATA
  DATAFILE 'D:\app\Administrator\virtual\oradata\ORCL\FCUBSPDB\dwh1_data01.dbf'
  SIZE 1G AUTOEXTEND ON NEXT 256M MAXSIZE UNLIMITED;


CREATE USER bronze IDENTIFIED BY "root"
  DEFAULT TABLESPACE DWH_DATA TEMPORARY TABLESPACE TEMP
  QUOTA UNLIMITED ON DWH_DATA;

CREATE USER silver IDENTIFIED BY "root"
  DEFAULT TABLESPACE DWH_DATA TEMPORARY TABLESPACE TEMP
  QUOTA UNLIMITED ON DWH_DATA;

CREATE USER gold IDENTIFIED BY "root"
  DEFAULT TABLESPACE DWH_DATA TEMPORARY TABLESPACE TEMP
  QUOTA UNLIMITED ON DWH_DATA;

GRANT CREATE SESSION, CREATE TABLE, CREATE VIEW, CREATE SEQUENCE,
      CREATE PROCEDURE, CREATE SYNONYM TO bronze, silver, gold;



create schema bronze;
create schema siliver;
create schema gold;

